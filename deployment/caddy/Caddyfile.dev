# Development / lab: certificates from Caddy's internal CA (browsers will warn; agents will not trust it unless the
# Caddy root certificate is installed in the Windows machine store). Never use this on the internet.
{
	local_certs
	# The root certificate cannot be installed into the container's trust store (read-only); do not try.
	skip_install_trust
	# Clients send no SNI when connecting to an IP address (EASYPATCH_DOMAIN=192.168.1.20), and behind Docker's port
	# mapping Caddy cannot fall back to the address the client dialed. Use the site's certificate for those connections.
	default_sni {$EASYPATCH_DOMAIN:localhost}
	admin off
	servers {
		protocols h1 h2
	}
}

import /etc/caddy/easypatch.caddy

{$EASYPATCH_DOMAIN:localhost} {
	import easypatch
}
